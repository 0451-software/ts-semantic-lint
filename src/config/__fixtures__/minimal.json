{
  "$schema": "./ts-semantic-lint.schema.json",
  "version": 1,
  "model": "jev-latest",
  "include": ["**/*.ts", "**/*.tsx"],
  "rules": [
    {
      "id": "minimal-rule",
      "where": { "kind": "function" },
      "question": {
        "type": "choice",
        "instructions": "Is this function simple?",
        "criteria": {
          "yes": "the function is simple",
          "no": "the function is not simple"
        }
      },
      "diagnostics": [
        {
          "when": { "choice": "no" },
          "level": "warn",
          "message": "function is too complex"
        }
      ]
    }
  ]
}
